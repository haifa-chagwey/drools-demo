package rules;

import com.haifachagwey.ruleengine.model.GlobalFact;

global java.util.Map outputs;
global java.util.Map configs;
dialect "mvel"

rule "ContractCustomerRule"
when
    $f : GlobalFact(
        properties["customerType"] == "CONTRACT"
    )
then
    outputs.put("customerCategory", "CONTRACT");
end
