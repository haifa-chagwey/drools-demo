package rules;

import com.haifachagwey.ruleengine.model.RuleContext;

dialect "mvel"

rule "VIPOrAdultUS"
when
    $c : RuleContext(
        (
            facts["country"] == "US" &&
            facts["age"] >= 18
        )
        ||

            facts["vip"] == tenantConfig["vip"]
    )
then
    $c.setResult("segment", "SPECIAL");
end
