package rules;

import com.haifachagwey.ruleengine.model.GlobalFact;

global java.util.Map outputs;
global java.util.Map configs;
dialect "mvel"

rule "VIPOrAdultUS"
when
    $f : GlobalFact(
        (
            properties["country"] == "US" &&
            properties["age"] >= 18
        )
        ||

            properties["vip"] == configs["vip"]
    )
then
    outputs.put("segment", "SPECIAL");
end
