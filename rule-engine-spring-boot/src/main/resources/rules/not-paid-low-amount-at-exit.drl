package rules;

import com.haifachagwey.ruleengine.model.GlobalFact;

global java.util.Map outputs;
global java.util.Map configs;
dialect "mvel"

//////////////////////////////////////////////////////
// Rule 1 - Night tolerance small amount
//////////////////////////////////////////////////////
rule "Night - low amount tolerated"
salience 100
when
    $f : GlobalFact(
        properties["deviceType"] == "EXIT" &&
        properties["amount"] <= configs["nightLowAmountThreshold"] &&
        (
            properties["exitTime"] >= "19:00" ||
            properties["exitTime"] <= "06:00"
        )
    )
then
    outputs.put("factAssociatedAction", "OPEN_BARRIER");
    outputs.put("financialAction", "LOST_REVENUE");
    System.out.println("Night + low amount → open barrier, lost revenue");
end

//////////////////////////////////////////////////////
// Rule 2 - Exit requires operator
//////////////////////////////////////////////////////
rule "Night - condition false"
salience 90
when
    $f : GlobalFact(
        properties["deviceType"] == "EXIT" &&
        !(
            properties["amount"] <= configs["nightLowAmountThreshold"] &&
            (
                properties["exitTime"] >= "19:00" ||
                properties["exitTime"] <= "06:00"
            )
        )
    )
then
    outputs.put("factAssociatedAction", "INTERCOM");
    outputs.put("financialAction", "DIRECT_PAYMENT");
    System.out.println("Night condition not met → intercom + direct payment");
end

//////////////////////////////////////////////////////
// Second Table
//////////////////////////////////////////////////////

rule "Exit - default requires operator"
salience 50
when
    $f : GlobalFact(
        properties["deviceType"] == "EXIT"
    )
then
    outputs.put("factAssociatedAction", "INTERCOM");
    outputs.put("financialAction", "DIRECT_PAYMENT");
    System.out.println("Default: operator handling required");
end
//////////////////////////////////////////////////////
//
//////////////////////////////////////////////////////

rule "Registered - auto handling valid contract"
salience 40
when
    $f : GlobalFact(
        properties["deviceType"] == "EXIT" &&
        properties["productGroup"] == "REGISTERED" &&
        properties["validContract"] == true &&
        properties["amount"] < configs["registeredMaxAmount"]
    )
then
    outputs.put("factAssociatedAction", "OPEN_BARRIER");
    outputs.put("financialAction", "EXCEPTIONAL_EXIT");
    System.out.println("Registered customer: open barrier, no charge");
end

//////////////////////////////////////////////////////
//
//////////////////////////////////////////////////////

rule "Short term - low amount - no fuzzy match"
salience 30
when
    $f : GlobalFact(
        properties["deviceType"] == "EXIT" &&
        properties["productGroup"] == "SHORT_TERM" &&
        properties["amount"] < configs["lowAmountThreshold"] &&
        properties["fuzzyMatchFound"] == false
    )
then
    outputs.put("factAssociatedAction", "OPEN_BARRIER");
    outputs.put("financialAction", "LOST_REVENUE");
    System.out.println("Low amount + no fuzzy match → lost revenue");
end
//////////////////////////////////////////////////////
//
//////////////////////////////////////////////////////
rule "Short term - fuzzy match unique"
salience 20
when
    $f : GlobalFact(
        properties["deviceType"] == "EXIT" &&
        properties["productGroup"] == "SHORT_TERM" &&
        properties["fuzzyMatchFound"] == true &&
        properties["uniqueFuzzyMatch"] == true
    )
then
    outputs.put("factAssociatedAction", "OPEN_BARRIER");
    outputs.put("financialAction", "MATCH_PAYMENT");
    System.out.println("Fuzzy match found and unique → match payment");
end

//////////////////////////////////////////////////////
//
//////////////////////////////////////////////////////

rule "Short term - high amount unpaid"
salience 10
when
    $rc : GlobalFact(
        properties["deviceType"] == "EXIT" &&
        properties["productGroup"] == "SHORT_TERM" &&
        properties["amount"] > configs["highAmountThreshold"]
    )
then
    $rc.setOutput("factAssociatedAction", "INTERCOM");
    $rc.setOutput("financialAction", "EXCEPTION");
    System.out.println("High amount → manual handling required");
end
