package rules;

import com.haifachagwey.ruleengine.model.RuleContext;

dialect "mvel"

//////////////////////////////////////////////////////
// Rule 1 - Night tolerance small amount
//////////////////////////////////////////////////////
rule "Night - low amount tolerated"
salience 100
when
    $c : RuleContext(
        inputs["deviceType"] == "EXIT" &&
        inputs["amount"] <= configs["nightLowAmountThreshold"] &&
        (
            inputs["exitTime"] >= "19:00" ||
            inputs["exitTime"] <= "06:00"
        )
    )
then
    $c.setOutput("action", "OPEN_BARRIER");
    $c.setOutput("financialAction", "LOST_REVENUE");
    System.out.println("Night + low amount → open barrier, lost revenue");
end

//////////////////////////////////////////////////////
// Rule 2 - Exit requires operator
//////////////////////////////////////////////////////
rule "Night - condition false"
salience 90
when
    $c : RuleContext(
        inputs["deviceType"] == "EXIT" &&
        !(
            inputs["amount"] <= configs["nightLowAmountThreshold"] &&
            (
                inputs["exitTime"] >= "19:00" ||
                inputs["exitTime"] <= "06:00"
            )
        )
    )
then
    $c.setOutput("action", "INTERCOM");
    $c.setOutput("financialAction", "DIRECT_PAYMENT");
    System.out.println("Night condition not met → intercom + direct payment");
end

//////////////////////////////////////////////////////
// Second Table
//////////////////////////////////////////////////////

rule "Exit - default requires operator"
salience 50
when
    $c : RuleContext(
        inputs["deviceType"] == "EXIT"
    )
then
    $c.setOutput("action", "INTERCOM");
    $c.setOutput("financialAction", "DIRECT_PAYMENT");
    System.out.println("Default: operator handling required");
end
//////////////////////////////////////////////////////
//
//////////////////////////////////////////////////////

rule "Registered - auto handling valid contract"
salience 40
when
    $c : RuleContext(
        inputs["deviceType"] == "EXIT" &&
        inputs["productGroup"] == "REGISTERED" &&
        inputs["validContract"] == true &&
        inputs["amount"] < configs["registeredMaxAmount"]
    )
then
    $c.setOutput("action", "OPEN_BARRIER");
    $c.setOutput("financialAction", "EXCEPTIONAL_EXIT");
    System.out.println("Registered customer: open barrier, no charge");
end

//////////////////////////////////////////////////////
//
//////////////////////////////////////////////////////

rule "Short term - low amount - no fuzzy match"
salience 30
when
    $c : RuleContext(
        inputs["deviceType"] == "EXIT" &&
        inputs["productGroup"] == "SHORT_TERM" &&
        inputs["amount"] < configs["lowAmountThreshold"] &&
        inputs["fuzzyMatchFound"] == false
    )
then
    $c.setOutput("action", "OPEN_BARRIER");
    $c.setOutput("financialAction", "LOST_REVENUE");
    System.out.println("Low amount + no fuzzy match → lost revenue");
end
//////////////////////////////////////////////////////
//
//////////////////////////////////////////////////////
rule "Short term - fuzzy match unique"
salience 20
when
    $c : RuleContext(
        inputs["deviceType"] == "EXIT" &&
        inputs["productGroup"] == "SHORT_TERM" &&
        inputs["fuzzyMatchFound"] == true &&
        inputs["uniqueFuzzyMatch"] == true
    )
then
    $c.setOutput("action", "OPEN_BARRIER");
    $c.setOutput("financialAction", "MATCH_PAYMENT");
    System.out.println("Fuzzy match found and unique → match payment");
end

//////////////////////////////////////////////////////
//
//////////////////////////////////////////////////////

rule "Short term - high amount unpaid"
salience 10
when
    $rc : RuleContext(
        inputs["deviceType"] == "EXIT" &&
        inputs["productGroup"] == "SHORT_TERM" &&
        inputs["amount"] > configs["highAmountThreshold"]
    )
then
    $rc.setOutput("action", "INTERCOM");
    $rc.setOutput("financialAction", "EXCEPTION");
    System.out.println("High amount → manual handling required");
end