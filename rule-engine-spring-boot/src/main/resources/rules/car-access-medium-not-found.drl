package rules;

import com.haifachagwey.ruleengine.model.RuleContext;

dialect "mvel"

//////////////////////////////////////////////////////
// Rule 1 - Default: operator handling
//////////////////////////////////////////////////////
rule "Car access - unknown LPN - operator"
salience 100
when
    $c : RuleContext(
        inputs["deviceType"] == "ENTRY" &&
        inputs["carAccess"] == true
    )
then
    $c.setOutput("action", "INTERCOM");
    System.out.println("Unknown LPN → operator handling");
end

//////////////////////////////////////////////////////
// Rule 2 - Auto handling - no fuzzy match
//////////////////////////////////////////////////////
rule "Car access - no fuzzy candidate"
salience 90
when
    $c : RuleContext(
        inputs["deviceType"] == "ENTRY" &&
        inputs["carAccess"] == true &&
        inputs["autoHandling"] == true &&
        (
            inputs["fuzzyEnabled"] == false ||
            (inputs["fuzzyEnabled"] == true && inputs["fuzzyMatchFound"] == false)
        )
    )
then
    $c.setOutput("action", "OPEN_BARRIER");
    $c.setOutput("financialAction", "CREATE_SHOWUP_PRODUCT");
    System.out.println("No fuzzy match → open barrier + showup");
end

//////////////////////////////////////////////////////
// Rule 3 - Auto handling - fuzzy match found
//////////////////////////////////////////////////////
rule "Car access - fuzzy candidate found"
salience 80
when
    $c : RuleContext(
        inputs["deviceType"] == "ENTRY" &&
        inputs["carAccess"] == true &&
        inputs["autoHandling"] == true &&
        inputs["fuzzyEnabled"] == true &&
        inputs["fuzzyMatchFound"] == true
    )
then
    $c.setOutput("action", "OPEN_BARRIER");
    $c.setOutput("financialAction", "REGISTERED_ENTRY");
    System.out.println("Fuzzy match → registered entry");
end