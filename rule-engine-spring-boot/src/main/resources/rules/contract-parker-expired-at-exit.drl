package rules;

import com.haifachagwey.ruleengine.model.RuleContext;

dialect "mvel"

//////////////////////////////////////////////////////
// Rule 1 - Direct payment required
//////////////////////////////////////////////////////
rule "Contract parker expired - direct payment"
salience 30
when
    $c : RuleContext(
        inputs["deviceType"] == "EXIT" &&
        inputs["productGroup"] == "CONTRACT" &&
        inputs["productExpired"] == true &&
        inputs["amount"] > configs["mediumAmountThreshold"]
    )
then
    $c.setOutput("action", "DIRECT_PAYMENT");
    System.out.println("Direct payment required");
end

//////////////////////////////////////////////////////
// Rule 2 - Later payment (invoice)
//////////////////////////////////////////////////////
rule "Contract parker expired - later payment"
salience 20
when
    $c : RuleContext(
        inputs["deviceType"] == "EXIT" &&
        inputs["productGroup"] == "CONTRACT" &&
        inputs["productExpired"] == true &&
        inputs["amount"] > configs["lowAmountThreshold"] &&
        inputs["amount"] <= configs["mediumAmountThreshold"]
    )
then
    $c.setOutput("Book amount", "LATER_PAYMENT");
    $c.setOutput("openBarrier", true);
end

//////////////////////////////////////////////////////
// Rule 3 - Lost revenue
//////////////////////////////////////////////////////
rule "Contract parker expired - lost revenue"
salience 10
when
    $c : RuleContext(
        inputs["deviceType"] == "EXIT" &&
        inputs["productGroup"] == "CONTRACT" &&
        inputs["productExpired"] == true &&
        inputs["amount"] <= configs["lowAmountThreshold"]
    )
then
    $c.setOutput("action", "LOST_REVENUE");
    $c.setOutput("openBarrier", true);
end